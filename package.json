{
  "name": "reuben-cloud",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build:image": "node scripts/build-images.ts",
    "build:base-images": "node scripts/build-images.ts --all",
    "build:proxy-image": "docker build -f deploy/egress-proxy/Dockerfile -t reuben-cloud/egress-proxy:dev .",
    "check:image": "node scripts/sandbox-image-check.ts",
    "dev:up": "docker compose up -d --wait db minio && docker compose run --rm minio-init",
    "dev:down": "docker compose down",
    "dev:ps": "docker compose ps",
    "dev:logs": "docker compose logs -f --tail=50",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose rm -sf db",
    "db:status": "docker compose ps db",
    "db:url": "echo postgres://postgres:${REUBEN_CLOUD_DB_PASSWORD:-x}@127.0.0.1:${REUBEN_CLOUD_DB_PORT:-55432}/reuben_cloud",
    "db:migrate": "node scripts/migrate.ts",
    "smoke": "node packages/e2e/src/smoke.ts",
    "agent:run": "node --env-file-if-exists=.env scripts/agent-run.ts",
    "env:build": "node --env-file-if-exists=.env scripts/build-env.ts",
    "index:repo": "node --env-file-if-exists=.env scripts/index-repo.ts",
    "vendor:tree-sitter": "node scripts/vendor-tree-sitter.ts",
    "app:installations": "node --env-file-if-exists=.env scripts/github-app-installations.ts",
    "proxy:up": "node scripts/egress-proxy.ts up",
    "proxy:down": "node scripts/egress-proxy.ts down",
    "proxy:status": "node scripts/egress-proxy.ts status"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
