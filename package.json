{
  "name": "reuben-cloud",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build:image": "docker build -f images/sandbox/Dockerfile -t reuben-cloud/sandbox-base:dev .",
    "check:image": "node scripts/sandbox-image-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
