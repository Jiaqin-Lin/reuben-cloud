{
  "name": "reuben-cloud",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build:image": "docker build -f images/sandbox/Dockerfile -t reuben-cloud/sandbox-base:dev .",
    "build:proxy-image": "docker build -f deploy/egress-proxy/Dockerfile -t reuben-cloud/egress-proxy:dev .",
    "check:image": "node scripts/sandbox-image-check.ts",
    "proxy:up": "node scripts/egress-proxy.ts up",
    "proxy:down": "node scripts/egress-proxy.ts down",
    "proxy:status": "node scripts/egress-proxy.ts status"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
