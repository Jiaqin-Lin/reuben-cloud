{
  "name": "@reuben-cloud/control-plane",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=60000 test/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=../../.env --test --test-concurrency=1 --test-timeout=300000 test/integration/*.test.ts",
    "test:live": "node --env-file-if-exists=../../.env --test --test-timeout=600000 test/live/*.live.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@reuben-cloud/agent-runtime": "*",
    "pg": "^8.23.0",
    "web-tree-sitter": "~0.27.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
